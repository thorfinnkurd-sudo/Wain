# Copy these into local.properties (KEY=value) or export as environment variables / GitHub Actions secrets.
# Everything is optional: unset values fall back to development defaults (clearly labelled in the app).
# These values are compiled into the APK. Use only client-side keys restricted to this app; never privileged keys.

# Vector map style (MapLibre style JSON URL). Needed for real street-level detail.
WAIN_MAP_STYLE_URL=
WAIN_MAP_STYLE_DARK_URL=

# Valhalla-compatible routing endpoint (no trailing path), e.g. your own server.
WAIN_ROUTING_URL=
WAIN_ROUTING_API_KEY=

# Nominatim-compatible geocoder and Overpass-compatible endpoints (defaults are public fair-use servers).
WAIN_GEOCODER_URL=
WAIN_OVERPASS_URL=

# Shared community reports (Supabase). The anon key is public by design; protection is the RLS policies in supabase/schema.sql.
WAIN_SUPABASE_URL=
WAIN_SUPABASE_ANON_KEY=

# Contact (email or URL) sent in the User-Agent, as required by Nominatim/Overpass policies.
WAIN_CONTACT=

# Release signing (CI or local only; never commit the keystore).
WAIN_KEYSTORE_PATH=
WAIN_KEYSTORE_PASSWORD=
WAIN_KEY_ALIAS=
WAIN_KEY_PASSWORD=
